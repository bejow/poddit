{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "plugin:react/recommended", "prettier"],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["react", "react-hooks", "prettier"],
  "rules": {
    "prettier/prettier": ["error", { "endOfLine": "auto" }],
    "react/react-in-jsx-scope": "off",
    "camelcase": "error",
    "spaced-comment": "error",
    "quotes": ["error", "double"],
    "no-duplicate-imports": "error",
    "indent": ["error", 2, { "SwitchCase": 1 }],
    "max-len": ["error", { "code": 100, "comments": 65, "tabWidth": 4 }]
  },
  "ignorePatterns": ["**/icons/*.js"],
  "globals": {
    // Fix testing "undefined" linting errors
    "cy": true,
    "it": true,
    "describe": true,
    "module": true,
    "exports": true,
    "require": true,
    "test": true,
    "expect": true,
    "global": true,
    "jest": true,
    "process": true
  }
}
